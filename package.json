{
  "name": "minisuper",
  "version": "0.3.0",
  "description": "Aplicación web para administrar un mini súper (ventas, caja, inventario, compras y reportes) con PostgreSQL y Sequelize.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "cargar-demo": "node scripts/cargar-demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "nodemon": "^3.1.14"
  }
}
