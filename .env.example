# Plantilla del archivo .env para la instalación manual o de desarrollo.
# Cópiala como .env y llena los valores. No subas .env a git.
# (Con MiniSuper-Setup.exe no hace falta: el instalador crea su propio .env
# en C:\ProgramData\MiniSuper.)

PORT=3000

# Desde dónde se puede entrar al sistema:
#   127.0.0.1 = solo desde esta computadora (lo más seguro, predeterminado)
#   0.0.0.0   = también desde otras (Tailscale o la red local)
HOST=127.0.0.1

# Conexión a PostgreSQL (los mismos datos que usas en pgAdmin).
# La base debe existir; las tablas las crea la aplicación al arrancar.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=minisuper
DB_PORT=5432

# Cadena larga y aleatoria para firmar la sesión (mínimo 32 caracteres).
SESSION_SECRET=

# true = la primera vez que arranca carga categorías, proveedores y 20
# productos de ejemplo. false para una tienda real.
DATOS_DE_PRUEBA=false

# --- Opcionales ---------------------------------------------------------
# RESPALDO_AUTOMATICO=false        # desactiva el respaldo diario
# PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# ACTUALIZAR_ESQUEMA=true          # fuerza revisar las tablas aunque los modelos no cambiaron
# ACTUALIZAR_SIN_RESPALDO=true     # actualiza las tablas aunque falle el respaldo previo (riesgoso)

# Nube (paso 3 de INSTALACION.md)
# SYNC_URL=https://tu-nube.onrender.com
# SYNC_TOKEN=clave-que-da-crear-tienda
# SYNC_INTERVALO=60

# Los datos de la tienda (nombre, dirección, RFC, IVA, métodos de pago…)
# se configuran dentro de la aplicación, en la sección Configuración.
