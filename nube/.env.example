# Base PostgreSQL de la nube (por ejemplo, la cadena de conexión de Neon)
DATABASE_URL=postgres://usuario:contraseña@servidor/base?sslmode=require
DATABASE_SSL=true

# Cadena aleatoria de 64 caracteres
SESSION_SECRET=

# Dirección pública de esta aplicación (la usa crear-tienda para mostrar SYNC_URL)
URL_PUBLICA=https://tu-nube.onrender.com

PORT=4000
